# Configura estos valores en el entorno seguro del servidor. No expongas la clave en el navegador.
# Groq (gratis) se usa primero si está configurada; si no, se usa OpenAI como respaldo.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Base de datos (perfil, tamizajes, memoria del chat, jardín de compañía).
# En Vercel se agrega sola al conectar un Postgres (Storage -> Create Database)
# al proyecto. Para probarla en local, copia el mismo valor desde el dashboard
# de Vercel (Storage -> tu base -> .env.local) a POSTGRES_URL aquí.
POSTGRES_URL=
